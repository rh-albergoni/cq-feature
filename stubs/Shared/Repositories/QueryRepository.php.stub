<?php

declare(strict_types=1);

namespace {{RootNamespace}}\Modules\{{Module}}\{{Domain}}\Shared\Repositories\Queries;

use {{RootNamespace}}\Modules\{{Module}}\{{Domain}}\Shared\Entities\{{Domain}}Entity;
use {{RootNamespace}}\Modules\{{Module}}\{{Domain}}\Shared\Models\{{Domain}};
use {{RootNamespace}}\Shared\Cqs\Repositories\Queries\BaseQueryRepository;
use Illuminate\Database\Eloquent\Builder;
use stdClass;

class {{Domain}}QueryRepository extends BaseQueryRepository
{
    public function __construct()
    {
        $this->model = new {{Domain}};
    }

    /**
     * Mapear item para Entity
     */
    protected function modelToEntity(array|stdClass|{{Domain}} $item): {{Domain}}Entity
    {
        return {{Domain}}Entity::from($item);
    }

    /**
     * Consulta base para retornar dados de Entity
     */
    protected function baseQuery(): Builder
    {
        return $this->model
            ->select(['{{table_name}}.*']);
    }
}
