<?php

declare(strict_types=1);

namespace {{RootNamespace}}\Modules\{{Module}}\{{Domain}}\Features\{{Domain}}{{Action}}\Services;

use {{RootNamespace}}\Modules\{{Module}}\{{Domain}}\Features\{{Domain}}Find\Dtos\{{Domain}}ViewDto;
use {{RootNamespace}}\Modules\{{Module}}\{{Domain}}\Features\{{Domain}}Find\Services\{{Domain}}FindService;
use {{RootNamespace}}\Modules\{{Module}}\{{Domain}}\Features\{{Domain}}{{Action}}\Dtos\{{Domain}}{{Action}}Dto;
use {{RootNamespace}}\Modules\{{Module}}\{{Domain}}\Features\{{Domain}}{{Action}}\Repositories\Commands\{{Domain}}{{Action}}CommandRepository;
use {{RootNamespace}}\Modules\{{Module}}\{{Domain}}\Shared\Entities\{{Domain}}Entity;
use {{RootNamespace}}\Shared\Services\BaseService;

final class {{Domain}}{{Action}}Service extends BaseService
{
    public function __construct(
        private readonly {{Domain}}{{Action}}CommandRepository $commandRepository,
        private readonly {{Domain}}FindService ${{domain_camel}}FindService,
    ) {
        parent::__construct();
    }

    public function execute({{Domain}}{{Action}}Dto $data, int $id): {{Domain}}ViewDto
    {
        return $this->handleTransaction(function () use ($data, $id) {
            $entity = {{Domain}}Entity::from($data);
            $this->commandRepository->execute($entity, $id);

            return $this->{{domain_camel}}FindService->execute($id);
        });
    }
}
