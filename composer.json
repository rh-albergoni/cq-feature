{
    "name": "cq/cqfeature",
    "description": "Gerador de scaffold DDD (Module/Domain/Feature) instalável para Laravel — pacote do FeatureMaker.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "illuminate/config": "^10.0|^11.0|^12.0",
        "illuminate/container": "^10.0|^11.0|^12.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Cq\\CqFeature\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cq\\CqFeature\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cq\\CqFeature\\Laravel\\CqFeatureServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist",
        "test:coverage": "phpunit -c phpunit.xml.dist --coverage-text"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
